### Create a Health Care Facility

### create Doctor

POST {{baseUrl}}/api/health-care-facilities/me/doctors
Authorization: {{DoctorToken}}
Content-Type: application/json

{
    "firstName": "John",
    "lastName": "Doe",
    "email": "do.doe@example.com",
    "password": "password123",
    "gender": 1,
    "dateOfBirth": "1985-05-15",
    "specialization": 2,
    "licenseNumber": "MED123456"
}


### login doctor

POST http://localhost:5001/api/users/login
Content-Type: application/json

{
    "email": "ali@example.com",
    "Password": "12er56ui90MO@"
}


### create Schdule

POST {{baseUrl}}/api/doctors/me/schedules
Authorization: {{DoctorToken}}
Content-Type: application/json

{
  "dayOfWeek": 7,
  "startTime": "08:00:00",
  "endTime": "17:00:00",
  "status": 1,
  "isAvailable": true,
  "note": "Morning schedule"
}



### get Schules 
GET {{baseUrl}}/api/doctors/me/schedules
Authorization: {{DoctorToken}}


# ==========================
# 🔹 GET Health Care Facility Schedule by ID
# ==========================
###
GET {{baseUrl}}/api/doctors/me/schedules/25af8a52-68bc-40d7-be8c-1fcf82c0749b
Authorization: {{DoctorToken}}

# ==========================
# 🔹 UPDATE Health Care Facility Schedule
# ==========================
###
PUT {{baseUrl}}/api/doctors/me/schedules/25af8a52-68bc-40d7-be8c-1fcf82c0749b
Authorization: {{DoctorToken}}
Content-Type: application/json

{
  "dayOfWeek": 4,
  "startTime": "09:00:00",
  "endTime": "13:00:00",
  "status": "Active",
  "isAvailable": true,
  "note": "Updated morning schedule love"
}

# ==========================
# 🔹 DELETE Health Care Facility Schedule
# ==========================
###
DELETE {{baseUrl}}/api/doctors/me/schedules/a49b95a7-fbca-4ff4-884b-efc95994e856
Authorization: {{DoctorToken}}

###
GET {{baseUrl}}/api/doctors/11fe2f9e-5c61-4f80-9b64-ff8aa67f4c6a/schedules

# ==========================
