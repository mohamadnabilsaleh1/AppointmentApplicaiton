    "name":"ARI",
    "description":"adslfkjasdf"
}



### get Department 
GET {{baseUrl}}/api/health-care-facilities/me/departments
Authorization: {{HelathCare}}


# ==========================
# 🔹 GET Department ID
# ==========================
###
GET {{baseUrl}}/api/health-care-facilities/me/departments/{{departmentId}}
Authorization: {{HelathCare}}

# ==========================
# 🔹 UPDATE Department
# ==========================
###
PUT {{baseUrl}}/api/health-care-facilities/me/departments/{{departmentId}}
Authorization: {{HelathCare}}
Content-Type: application/json

{
    "name":"loveyou",
    "description":"adslfkjasdf"
}

# ==========================
# 🔹 DELETE Department
# ==========================
###
DELETE {{baseUrl}}/api/health-care-facilities/me/departments/{{departmentId}}
Authorization: {{HelathCare}}

### Add Doctor To Department

POST {{baseUrl}}/api/health-care-facilities/me/departments/{{departmentId}}/doctors/bfdab99f-e03a-4a18-a9fe-aae790ee784f
Authorization: {{HelathCare}}

### Delete Doctor To Department

DELETE  {{baseUrl}}/api/health-care-facilities/me/departments/{{departmentId}}/doctors/bfdab99f-e03a-4a18-a9fe-aae790ee784f
Authorization: {{HelathCare}}

### get Doctors of Department 

GET {{baseUrl}}/api/health-care-facilities/me/departments/{{departmentId}}/doctors
Authorization: {{HelathCare}}

