### Create a Health Care Facility
POST {{baseUrl}}/api/health-care-facilities
Authorization: {{AdminToken}}
Content-Type: application/json

 {
    "firstName": "Khaled",
    "lastName": "Clinic",
  "Email": "khaled.clinic@example.com",
  "Password": "12er56ui90MO@",
    "name": "khaled",
    "type": 0,
    "street": "220 Coastal Rd",
    "city": "Tartus",
    "state": "Tartus Governorate",
    "country": "Syria",
    "zipCode": "49005",
    "gpsLatitude": 34.887,
    "gpsLongitude": 35.8869
  }

###
POST http://localhost:5001/api/users/login
Content-Type: application/json

{
  "Email": "khaled.clinic@example.com",
  "Password": "12er56ui90MO@"
}





### create Upload

POST {{baseUrl}}/api/health-care-facilities/me/uploads
Authorization: {{HelathCare}}

Content-Type: application/json

{
  "file": "base64encodedFileHere",
  "title": "My File",
  "description": "File description",
  "visibility": 1  
}



### get Uploads 
GET {{baseUrl}}/api/health-care-facilities/me/uploads
Authorization: {{HelathCare}}



### get Upload By Id
GET {{baseUrl}}/api/health-care-facilities/me/uploads/{{uploadId}}
Authorization: {{HelathCare}}


### update upload 
PUT {{baseUrl}}/api/health-care-facilities/me/uploads/{{uploadId}}
Authorization: {{HelathCare}}
Content-Type: application/json

{
  "title": "Updated Title",
  "description": "Updated description"
}

# ==========================
# 🔹 DELETE Health Care Facility upload
# ==========================
###
DELETE {{baseUrl}}/api/health-care-facilities/me/uploads/{{uploadId}}
Authorization: {{HelathCare}}









###
