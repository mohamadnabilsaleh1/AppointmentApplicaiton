}


###
PUT {{baseUrl}}/api/doctors/me/appointments/26533ad6-c7c2-4428-9de9-c1187097369c/complete
Authorization: {{DoctorToken}}
Content-Type: application/json

{
  "diagnosis": "Common cold with mild fever",
  "treatmentNotes": "Patient presented with cough, runny nose, and temperature of 38°C",
  "followUpInstructions": "Rest for 2 days, drink plenty of fluids, return if symptoms worsen",
  "medicationList": "Paracetamol 500mg, Vitamin C 1000mg, Cough syrup",
  "dosageInstructions": "Paracetamol: 1 tablet every 6 hours, Vitamin C: once daily, Cough syrup: 10ml every 8 hours"
}