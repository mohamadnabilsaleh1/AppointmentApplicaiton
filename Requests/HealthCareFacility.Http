    "firstName": "Khaled",
    "lastName": "Clinic",
    "email": "khaled.clinic@example.com",
    "password": "12er56ui90MO@",
    "name": "Khaled Specialty Clinic",
    "type": 0,
    "street": "220 Coastal Rd",
    "city": "Tartus",
    "state": "Tartus Governorate",
