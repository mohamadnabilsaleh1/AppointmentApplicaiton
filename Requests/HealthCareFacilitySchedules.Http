@scheduleId = 3s
# ==========================
# Create Health Care Facility Schedule
# ==========================
POST https://localhost:5001/api/health-care-facilities/me/schedules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dayOfWeek": "Monday",
  "startTime": "08:00:00",
  "endTime": "12:00:00",
  "status": "Active",
  "isAvailable": true,
  "note": "Morning schedule"
}

# ==========================
# Get All Health Care Facility Schedules
# ==========================
GET https://localhost:5001/api/health-care-facilities/me/schedules
Authorization: Bearer {{token}}

# ==========================
# Get Health Care Facility Schedule by ID
# ==========================
GET https://localhost:5001/api/health-care-facilities/me/schedules/{{scheduleId}}
Authorization: Bearer {{token}}

# ==========================
# Update Health Care Facility Schedule
# ==========================
PUT https://localhost:5001/api/health-care-facilities/me/schedules/{{scheduleId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dayOfWeek": "Monday",
  "startTime": "09:00:00",
  "endTime": "13:00:00",
  "status": "Active",
  "isAvailable": true,
  "note": "Updated morning schedule"
}

# ==========================
# Delete Health Care Facility Schedule
# ==========================
DELETE https://localhost:5001/api/health-care-facilities/me/schedules/{{scheduleId}}
Authorization: Bearer {{token}}
