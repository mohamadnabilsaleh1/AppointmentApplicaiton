### Create a Health Care Facility

### create Doctor

POST {{baseUrl}}/api/health-care-facilities/me/doctors
Authorization: {{DoctorToken}}
Content-Type: application/json

{
    "firstName": "John",
    "lastName": "Doe",
    "email": "do.doe@example.com",
    "password": "password123",
    "gender": 1,
    "dateOfBirth": "1985-05-15",
    "specialization": 2,
    "licenseNumber": "MED123456"
}


### login doctor

POST http://localhost:5001/api/users/login
Content-Type: application/json

{
    "email": "ali@example.com",
    "Password": "12er56ui90MO@"
}


### create Schdule

POST {{baseUrl}}/api/doctors/me/schedule-exceptions
Authorization: {{DoctorToken}}
Content-Type: application/json

{
  "date": "2022-05-15",
  "dayOfWeek": 3,
  "startTime": "08:00:00",
  "endTime": "12:00:00",
  "status": 1,
  "reason": "Morning schedule"
}



### get Schules 
GET {{baseUrl}}/api/doctors/me/schedule-exceptions
Authorization: {{DoctorToken}}


# ==========================
# 🔹 GET Health Care Facility Schedule by ID
# ==========================
###
GET {{baseUrl}}/api/doctors/me/schedule-exceptions/{{scheduleId}}
Authorization: {{DoctorToken}}

# ==========================
# 🔹 UPDATE Health Care Facility Schedule
# ==========================
###
PUT {{baseUrl}}/api/doctors/me/schedule-exceptions/{{scheduleId}}
Authorization: {{DoctorToken}}
Content-Type: application/json

{
  "date": "2024-01-18",
  "dayOfWeek": 4,
  "startTime": "09:00:00",
  "endTime": "13:00:00",
  "status": 1,
  "reason": "Updated morning schedule fucking"
}

# ==========================
# 🔹 DELETE Health Care Facility Schedule
# ==========================
###
DELETE {{baseUrl}}/api/doctors/me/schedule-exceptions/003625e7-33b9-46a0-a996-f265e5218d90
Authorization: {{DoctorToken}}

###
GET {{baseUrl}}/api/doctors/{{doctorId}}/schedule-exceptions

# ==========================
# 🔹 GET Health Care Facility Schedule by ID
# ==========================
###
GET {{baseUrl}}/api/doctors/{{doctorId}}/schedule-exceptions/bf4f45cd-d6d3-47d6-b54d-a8a44c878dd5
