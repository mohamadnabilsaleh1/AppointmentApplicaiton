### Create a Health Care Facility

### create Doctor

POST {{baseUrl}}/api/health-care-facilities/me/doctors
Authorization: {{DoctorToken}}
Content-Type: application/json

{
    "firstName": "John",
    "lastName": "Doe",
    "email": "do.doe@example.com",
    "password": "password123",
    "gender": 1,
    "dateOfBirth": "1985-05-15",
    "specialization": 2,
    "licenseNumber": "MED123456"
}


### login doctor

POST http://localhost:5001/api/users/login
Content-Type: application/json

{
    "email": "ali@example.com",
    "Password": "12er56ui90MO@"
}


### create Schdule

POST {{baseUrl}}/api/doctors/me/schedules
Authorization: {{DoctorToken}}
Content-Type: application/json

{
  "dayOfWeek": 4,
  "startTime": "08:00:00",
  "endTime": "12:00:00",
  "status": 1,
  "isAvailable": true,
  "note": "Morning schedule"
}



### get Schules 
GET {{baseUrl}}/api/doctors/me/schedules
Authorization: {{DoctorToken}}


# ==========================
# 🔹 GET Health Care Facility Schedule by ID
# ==========================
###
GET {{baseUrl}}/api/doctors/me/schedules/{{scheduleId}}
Authorization: {{DoctorToken}}

# ==========================
# 🔹 UPDATE Health Care Facility Schedule
# ==========================
###
PUT {{baseUrl}}/api/doctors/me/schedules/{{scheduleId}}
Authorization: {{DoctorToken}}
Content-Type: application/json

{
  "dayOfWeek": 4,
  "startTime": "09:00:00",
  "endTime": "13:00:00",
  "status": "Active",
  "isAvailable": true,
  "note": "Updated morning schedule love"
}

# ==========================
# 🔹 DELETE Health Care Facility Schedule
# ==========================
###
DELETE {{baseUrl}}/api/doctors/me/schedules/{{scheduleId}}
Authorization: {{DoctorToken}}

###
GET {{baseUrl}}/api/doctors/{{doctorId}}/schedules

# ==========================
# 🔹 GET Health Care Facility Schedule by ID
# ==========================
###
GET {{baseUrl}}/api/doctors/{{doctorId}}/schedules/faa2bcc5-d20b-4a55-a461-3a9ff7dd3456
