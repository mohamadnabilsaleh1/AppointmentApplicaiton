### Create a Health Care Facility
POST {{baseUrl}}/api/health-care-facilities
Authorization: {{AdminToken}}
Content-Type: application/json

 {
    "firstName": "Khaled",
    "lastName": "Clinic",
  "Email": "khaled.clinic@example.com",
  "Password": "12er56ui90MO@",
    "name": "khaled",
    "type": 0,
    "street": "220 Coastal Rd",
    "city": "Tartus",
    "state": "Tartus Governorate",
    "country": "Syria",
    "zipCode": "49005",
    "gpsLatitude": 34.887,
    "gpsLongitude": 35.8869
  }

###
POST http://localhost:5001/api/users/login
Content-Type: application/json

{
  "Email": "khaled.clinic@example.com",
  "Password": "12er56ui90MO@"
}





### create Schdule

POST {{baseUrl}}/api/health-care-facilities/me/schedules
Authorization: {{HelathCare}}

Content-Type: application/json

{
  "dayOfWeek": 5,
  "startTime": "08:00:00",
  "endTime": "12:00:00",
  "status": 1,
  "isAvailable": true,
  "note": "Morning schedule"
}



### get Schules 
GET {{baseUrl}}/api/health-care-facilities/me/schedules
Authorization: {{HelathCare}}


# ==========================
# 🔹 GET Health Care Facility Schedule by ID
# ==========================
###
GET {{baseUrl}}/api/health-care-facilities/me/schedules/{{scheduleId}}
Authorization: {{HelathCare}}

# ==========================
# 🔹 UPDATE Health Care Facility Schedule
# ==========================
###
PUT {{baseUrl}}/api/health-care-facilities/me/schedules/{{scheduleId}}
Authorization: {{HelathCare}}
Content-Type: application/json

{
  "dayOfWeek": 4,
  "startTime": "09:00:00",
  "endTime": "13:00:00",
  "status": "Active",
  "isAvailable": true,
  "note": "Updated morning schedule love"
}

# ==========================
# 🔹 DELETE Health Care Facility Schedule
# ==========================
###
DELETE {{baseUrl}}/api/health-care-facilities/me/schedules/{{scheduleId}}
Authorization: {{HelathCare}}

###
GET {{baseUrl}}/api/health-care-facilities/08ab65af-cdb4-4f2f-910f-cd45a1ba5eaf/schedules
Authorization: {{HelathCare}}

# ==========================
# 🔹 GET Health Care Facility Schedule by ID
# ==========================
###
GET {{baseUrl}}/api/health-care-facilities/08ab65af-cdb4-4f2f-910f-cd45a1ba5eaf/schedules/{{scheduleId}}
Authorization: {{HelathCare}}